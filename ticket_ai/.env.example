# Copy to .env. Every value is optional: with none set, the app runs offline on a
# synthetic extract, with a local keyword heuristic standing in for the LLM.

# Your ticket extract (CSV or XLSX). Empty = generate a synthetic one.
TICKETS_PATH=

# Any OpenAI-compatible chat-completions API: OpenAI, Azure gateway, vLLM, Ollama...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
# Mask emails / phones / IBANs / card numbers before text is sent to the API.
LLM_REDACT_PII=true

# auto | sbert | tfidf   (sbert needs: pip install sentence-transformers)
EMBEDDING_BACKEND=auto
MOCK_TICKETS=5000
