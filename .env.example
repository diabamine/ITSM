# All settings are optional; defaults make the project run fully offline.
ITSM_DATA_DIR=./data
ITSM_ARTIFACTS_DIR=./artifacts
ITSM_DATASET=synthetic            # synthetic | csv | huggingface | uci_incident_log
ITSM_SYNTHETIC_N_TICKETS=8000
ITSM_SYNTHETIC_SEED=42
# Text representation backend: tfidf (default, offline) | embeddings (needs [hf] extra)
ITSM_EMBEDDING_BACKEND=tfidf
ITSM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Sentiment backend: lexicon (default, offline) | transformer (needs [hf] extra)
ITSM_SENTIMENT_BACKEND=lexicon
ITSM_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
ITSM_API_TITLE="ITSM Insights API"
ITSM_LOG_LEVEL=INFO

# --- privacy -----------------------------------------------------------
# Detector: rules (offline, no download) | transformer (needs the [hf] extra)
#         | presidio (needs the [presidio] extra + one spaCy model; runs alone,
#           no rule layer underneath, so it can be benchmarked on its own)
ITSM_ANONYMISATION_BACKEND=rules
ITSM_NER_MODEL=Davlan/distilbert-base-multilingual-cased-ner-hrl
# Presidio is configured for one language at a time; on a bilingual corpus that
# is a measurable trade, not a formality (docs/07-privacy.md).
ITSM_PRESIDIO_LANGUAGE=en
# Leave unset to use the default pipeline for that language (en_core_web_lg).
# ITSM_PRESIDIO_SPACY_MODEL=fr_core_news_lg
# When true, every pipeline reads tickets_anonymised.parquet instead of the raw
# extract. Produce it first with `itsm privacy anonymise`.
ITSM_USE_ANONYMISED=false
