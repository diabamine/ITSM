# All settings are optional; defaults make the project run fully offline.
ITSM_DATA_DIR=./data
ITSM_ARTIFACTS_DIR=./artifacts
ITSM_DATASET=synthetic            # synthetic | csv | huggingface | uci_incident_log
ITSM_SYNTHETIC_N_TICKETS=8000
ITSM_SYNTHETIC_SEED=42
# Text representation backend: tfidf (default, offline) | embeddings (needs [hf] extra)
ITSM_EMBEDDING_BACKEND=tfidf
ITSM_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Sentiment backend: lexicon (default, offline) | transformer (needs [hf] extra)
ITSM_SENTIMENT_BACKEND=lexicon
ITSM_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
ITSM_API_TITLE="ITSM Insights API"
ITSM_LOG_LEVEL=INFO
